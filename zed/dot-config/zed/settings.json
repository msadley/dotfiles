{
  // # UI & Appearance
  "soft_wrap": "editor_width",
  "theme": "Rosé Pine",
  "icon_theme": "Zed (Default)",
  "ui_font_family": "SF Pro Display",
  "ui_font_size": 16,
  "window_decorations": "server",
  "current_line_highlight": "gutter",
  "text_rendering_mode": "platform_default",

  // # Editor & Formatting
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_fallbacks": ["SF Pro Rounded"],
  "buffer_font_size": 16.0,
  "tab_size": 2,
  "cursor_shape": "bar",
  "cursor_blink": false,
  "relative_line_numbers": "disabled",
  "auto_indent_on_paste": true,
  "use_on_type_format": true,
  "inline_code_actions": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "formatter": [
    "prettier",
    {
      "code_action": "source.fixAll.eslint"
    }
  ],

  // # Gutter, Minimap & Scrollbar
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "line_width": 0,
    "active_line_width": 1,
    "enabled": true
  },
  "gutter": {
    "min_line_number_digits": 1,
    "folds": false,
    "bookmarks": false,
    "breakpoints": false,
    "runnables": false,
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "show": "never"
  },

  // # Keymaps & Vim
  "base_keymap": "VSCode",
  "vim_mode": true,
  "vim": {
    "cursor_shape": {
      "visual": "hollow",
      "replace": "block",
      "normal": "underline"
    }
  },

  // # Layout & Panels
  "title_bar": {
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "button_layout": "",
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_branch_name": true,
    "show_branch_status_icon": true
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": false,
    "show_tab_bar_buttons": true
  },
  "tabs": {
    "show_close_button": "hover",
    "close_position": "right",
    "file_icons": false,
    "show_diagnostics": "all"
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": false,
    "line_endings_button": false,
    "experimental.show": false
  },
  "project_panel": {
    "button": false,
    "indent_guides": {
      "show": "never"
    },
    "git_status": true,
    "entry_spacing": "comfortable",
    "hide_hidden": false,
    "git_status_indicator": false,
    "diagnostic_badges": true,
    "scrollbar": {
      "horizontal_scroll": false,
      "show": "never"
    },
    "folder_icons": true,
    "hide_root": true,
    "bold_folder_labels": false,
    "hide_gitignore": true,
    "dock": "right",
    "auto_reveal_entries": true
  },
  "git_panel": {
    "folder_icons": true
  },
  "outline_panel": {
    "folder_icons": true
  },
  "search": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "diagnostics": {
    "button": false,
    "inline": {
      "enabled": true
    }
  },
  "terminal": {
    "font_size": 13.0,
    "font_family": "Liga SFMonoNerdFont",
    "button": false
  },

  // # Languages & LSP
  "languages": {},
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 3184
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },

  // # AI & Agent
  "disable_ai": false,
  "agent": {
    "sandbox_permissions": {
      "network_hosts": ["raw.githubusercontent.com"]
    },
    "play_sound_when_agent_done": "always",
    "enable_feedback": false,
    "dock": "left",
    "sidebar_side": "left",
    "favorite_models": [],
    "model_parameters": []
  },

  // # System, Git & Telemetry
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "use_system_path_prompts": true,
  "use_system_prompts": true,
  "cli_default_open_behavior": "existing_window"
}
