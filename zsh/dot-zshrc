autoload -Uz glob

# Register custom completions directory in fpath BEFORE compinit runs
fpath=(/home/adley/.config/zsh/completions $fpath)

# Load all .zsh modules (excluding completions)
for file in /home/adley/.config/zsh/*.zsh(.N) /home/adley/.config/zsh/apps/*.zsh(.N); do
  source "$file"
done

# Automatically start hyprland from tty
if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
      exec start-hyprland
fi

